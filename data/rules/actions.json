{
  "$comment": "主動行動：擲骰先發生，程式算出參考 DC；再把完整資料與骰值交給 AI，由 AI 決定成功與否（骰值只是參考，可以出乎預料）並直接寫出結果。AI 標示的 DC 夾在參考值 ±dc_adjust；AI 提出的效果只能是 kinds.effects 中的種類，數值夾在 caps 內。AI 關閉時用 attr 與參考 DC 依 degrees 判定。說明見 docs/RELATIONSHIP_MEMORY.md 第 5 節。",
  "version": 1,
  "dc_adjust": 3,
  "degrees": {
    "$comment": "規則判定（AI 關閉時），以及給 AI 的參考：自然 20 或 總值 ≥ DC + critical_margin → 大成功；總值 ≥ DC → 成功；總值 ≥ DC - partial_margin → 部分成功；自然 1 或 總值 ≤ DC - fumble_margin → 大失敗；其餘失敗。",
    "critical_margin": 10,
    "partial_margin": 3,
    "fumble_margin": 10
  },
  "caps": {
    "$comment": "AI 提出的效果上限（每次行動）。money 與 xp 依主角等級乘上倍數。",
    "affinity": 8,
    "reputation": 2,
    "money_cc_per_level": 30,
    "xp_per_level": 15,
    "item_qty": 1,
    "items": 2,
    "flags": 3,
    "relationship_text_chars": 120,
    "summary_chars": 160,
    "narrative_chars": 2000
  },
  "kinds": {
    "free": {
      "name": "自由行動",
      "attr": "cha",
      "base": 12,
      "hours": 0.5,
      "effects": ["affinity", "relationship_text", "flag", "reputation", "money", "item", "xp"],
      "$comment_base": "有對象時 DC = base + 2 × max(0, 對方生命層級 - 主角生命層級) - floor(親密度 / 25)"
    },
    "hire": { "name": "雇傭談判", "attr": "cha", "hours": 0.5, "effects": ["affinity", "relationship_text", "flag"] },
    "haggle": { "name": "殺價", "attr": "cha", "hours": 0.5, "effects": ["affinity", "relationship_text", "flag"] },
    "invite": { "name": "邀請入隊", "attr": "cha", "hours": 0.5, "effects": ["affinity", "relationship_text", "flag"] },
    "black_market": { "name": "打聽黑市", "attr": "cha", "hours": 2, "effects": ["flag", "reputation", "money"] },
    "negotiate": { "name": "談判解除契約", "attr": "cha", "hours": 1, "effects": ["affinity", "relationship_text", "flag"] },
    "escape": { "name": "逃離主人", "attr": "dex", "hours": 2, "effects": ["affinity", "relationship_text", "flag"] }
  }
}
