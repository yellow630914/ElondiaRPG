{
  "$comment": "商店類型與交易清單。每份交易 = 付出（gives：金錢、物品、時間）＋ 得到（gets：報酬模板的效果，可複合）。清單每天每間店生成一次：AI 判定開啟時由 AI 依商店類型生成，否則依 catalog 與 specials 生成。一般交易直接計算，不需要 AI；只有主角主動交涉時才檢定。npc 寫 keeper 代表店主、party 代表每位隊友。",
  "version": 1,
  "location_price_mult": { "capital": 1.15, "city": 1.1, "port": 1.0, "town": 1.0, "village": 1.2, "outpost": 1.25, "fortress": 1.2 },
  "location_rank": { "village": 0, "outpost": 0, "fortress": 0, "town": 1, "port": 1, "city": 2, "capital": 3 },
  "affinity_discount_per_point": 0.002,
  "max_affinity_discount": 0.1,
  "max_deals": 10,
  "ai_caps": { "affinity": 3, "reputation": 1, "price_floor_ratio": 0.8, "deals": 8, "stock": 5 },
  "bargain": {
    "$comment": "對單筆交易交涉（主動行動）：DC = base - floor(店主親密度 / 25)。成功程度決定價格倍率，每筆每天一次。",
    "base": 12,
    "price_factor": { "critical": 0.7, "success": 0.85, "partial": 0.95, "fail": 1.0, "fumble": 1.1 }
  },
  "types": {
    "general": {
      "name": "雜貨店",
