      "buys": ["food", "gear", "material", "valuable", "equipment"],
      "ai_effects": ["item", "affinity", "flag", "memory", "gear"],
      "specials": [
        { "id": "haul", "title": "幫店主搬貨", "desc": "花一個小時搬貨，換一點工錢。", "gives": [{ "type": "hours", "amount": 1 }],
          "gets": [{ "type": "money", "amount": 10 }, { "type": "affinity", "npc": "keeper", "delta": 2 }], "stock": 1 }
      ]
    },
    "temple": {
      "name": "神殿",
      "cell": "temple",
      "keeper": { "classes": ["cleric", "paladin"], "title": "司祭" },
      "catalog_tag": "temple",
      "buys": ["valuable", "scroll"],
      "ai_effects": ["item", "affinity", "flag", "memory", "reputation", "condition"],
      "specials": [
        { "id": "donate", "title": "捐獻", "desc": "向神殿捐獻，聲望提升。", "gives": [{ "type": "money", "amount": 100 }],
          "gets": [{ "type": "reputation", "faction": "local", "delta": 1 }, { "type": "affinity", "npc": "keeper", "delta": 2 }], "stock": 1 },
        { "id": "bless", "title": "祈求祝福", "desc": "下次長休前，所有主動行動檢定 +1。", "gives": [{ "type": "money", "amount": 50 }],
          "gets": [{ "type": "condition", "target": "pc", "condition": "blessed", "add": true }], "stock": 1 }
      ]
    },
    "tavern": {
      "name": "酒館",
      "cell": "tavern",
      "keeper": { "classes": ["fighter", "bard", "rogue"], "title": "酒保" },
      "catalog_tag": "tavern",
      "buys": ["food", "valuable", "info"],
      "ai_effects": ["item", "affinity", "flag", "memory", "companion"],
      "specials": [
        { "id": "round", "title": "請全場喝一杯", "desc": "隊友們都很開心。", "gives": [{ "type": "money", "amount": 30 }],
          "gets": [{ "type": "affinity", "npc": "party", "delta": 2 }, { "type": "affinity", "npc": "keeper", "delta": 1 }], "stock": 1 },
        { "id": "rumor", "title": "向酒保買情報", "desc": "打聽附近的消息。", "gives": [{ "type": "money", "amount": 100 }],
          "gets": [{ "type": "flag", "key": "rumor", "value": true }, { "type": "memory", "summary": "從酒保那裡打聽到附近的消息。", "importance": 1 }], "stock": 1 }
      ]
    }
