{
  "$comment": "奴隸市場、奴隸契約與契約印記。價格依世界書「奴隸交易價格參考」（金額單位為白鸛幣；世界書的 1 金幣 = 100、1 白金幣 = 1000 白鸛幣）。人類國家合法且興盛；魔族聯盟多以物易物；精靈王庭禁止奴隸交易，精靈只在黑市出現、風險極高。說明見 docs/COMPANIONS.md。",
  "version": 1,

  "prices_cc": {
    "$comment": "依生命層級與種族群組的價格區間。層級內依等級線性內插，再乘上職業與種族倍率、市場倍率與 ±variance 的浮動。第 4 層以上每層 × beyond_tier3_mult。",
    "1": { "human": [800, 8000], "demon": [1000, 9000], "elf": [8000, 40000] },
    "2": { "human": [20000, 25000], "demon": [22000, 28000], "elf": [250000, 280000] },
    "3": { "human": [400000, 450000], "demon": [450000, 500000], "elf": [2000000, 2500000] },
    "beyond_tier3_mult": 5,
    "variance": 0.25,
    "race_group": { "human": "human", "catfolk": "human", "dwarf": "human", "demon": "demon", "elf": "elf", "yulin": "elf" },
    "race_mult": { "catfolk": 0.9, "dwarf": 1.2 },
    "class_mult": { "wizard": 1.3, "cleric": 1.25, "druid": 1.2, "bard": 1.1, "paladin": 1.15 }
  },

  "black_market_only": ["elf", "yulin"],

  "markets": {
    "rhineburg": { "public": { "name": "帝國奴隸市場", "price_mult": 1.0, "stock": [3, 5], "races": { "human": 6, "catfolk": 2, "dwarf": 1, "demon": 1 } } },
    "dawnlight": { "public": { "name": "晨光城奴隸拍賣場", "price_mult": 1.05, "stock": [3, 4], "races": { "human": 6, "catfolk": 2, "demon": 1 } } },
    "albena": {
      "public": { "name": "自由集市・奴隸區", "price_mult": 0.95, "stock": [3, 5], "races": { "human": 5, "catfolk": 2, "dwarf": 1, "demon": 2 } },
      "black": { "name": "自由集市地下拍賣", "price_mult": 0.8, "stock": [2, 4], "races": { "human": 3, "demon": 2, "elf": 2, "yulin": 1 } }
    },
    "soriel": { "black": { "name": "外環的地下奴隸販子", "price_mult": 0.85, "stock": [2, 3], "races": { "human": 4, "catfolk": 2, "elf": 1 } } },
    "bloodplume": { "public": { "name": "血羽城堡交易廣場（以物易物）", "price_mult": 1.1, "stock": [3, 5], "races": { "demon": 4, "human": 4, "catfolk": 1 } } },
    "shadow_vale": { "public": { "name": "陰影之谷奴隸市", "price_mult": 1.0, "stock": [2, 4], "races": { "demon": 4, "human": 3 } } },
    "ashport": { "black": { "name": "灰港鎮碼頭黑市", "price_mult": 0.75, "stock": [3, 5], "races": { "human": 3, "demon": 3, "catfolk": 1, "elf": 1 } } },
    "tidehaven": { "black": { "name": "潮汐港走私船艙", "price_mult": 0.9, "stock": [2, 3], "races": { "human": 2, "yulin": 1, "elf": 1 } } }
  },

  "black_market_search": { "attr": "cha", "dc": 14, "hours": 2 },

  "haggle": {
    "$comment": "殺價、魅惑等主動行動。成功程度決定價格倍率；失敗後當天不能再殺價。DC = base + 2 × 市場是黑市。",
    "attr": "cha",
    "base": 12,
    "black_market_bonus": 2,
    "price_factor": { "critical": 0.7, "success": 0.85, "partial": 0.95, "fail": 1.0, "fumble": 1.1 }
  },

  "self_sale": {
    "$comment": "主角在市場登記出售自己。買家出現機率 = base + per_cha_mod × mod(魅力) + per_level × 等級；主角拿到成交價的 share（賣身錢）。幾乎無法主動影響。",
    "hours": 6,
    "base": 0.3,
    "per_cha_mod": 0.07,
    "per_level": 0.03,
    "max": 0.85,
    "share": 0.2,
    "contract_weights": { "labor": 6, "combat": 3, "arcane": 1 }
  },

  "contracts": {
    "labor": {
      "name": "勞役契約",
      "mark": "頸側一圈暗紅色的荊棘紋，主人的名字以細小的古文字刻在紋路之間。",
      "functions": ["identity", "obedience", "income", "tracking"],
      "obedience_penalty": 2,
      "income_share": 0.5,
      "negotiate_dc": 18,
      "escape_dc": 17,
      "recapture_chance": 0.1,
      "exit_dc": 12,
      "side_effects": ["違抗主人的命令時印記會刺痛", "見到主人時頸部微微發熱"],
      "escape_effects": { "hp_ratio": 0.1 }
    },
    "combat": {
      "name": "戰奴契約",
      "mark": "頸後一枚交叉雙劍的黑色烙印，延伸出鎖鏈狀的紋路繞過喉頭。",
      "functions": ["identity", "obedience", "income", "tether", "tracking"],
      "obedience_penalty": 3,
      "income_share": 1.0,
      "negotiate_dc": 20,
      "escape_dc": 19,
      "recapture_chance": 0.2,
      "exit_dc": 14,
      "side_effects": ["無法對主人揮出武器", "離主人太遠時鎖鏈紋會收緊，呼吸困難"],
      "escape_effects": { "hp_ratio": 0.3 }
    },
    "arcane": {
      "name": "魔導束縛契約",
      "mark": "喉頭正中一枚淡紫色的法陣，會隨主人的魔力脈動。",
      "functions": ["identity", "obedience", "income", "tracking", "spell_seal"],
      "obedience_penalty": 5,
      "income_share": 1.0,
      "spell_cap": 1,
      "negotiate_dc": 22,
      "escape_dc": 22,
      "recapture_chance": 0.35,
      "exit_dc": 16,
      "side_effects": ["法陣抽取魔力，最多只能施放 1 環法術", "主人能感知印記的位置"],
      "escape_effects": { "hp_ratio": 0.4 }
    }
  },

  "functions": {
    "identity": "身分標示：任何人一眼就能認出是奴隸與其主人。",
    "obedience": "服從：對主人的檢定受到懲罰。",
    "income": "收益歸屬：奴隸得到的金錢有一部分（或全部）歸主人。",
    "tether": "距離束縛：逃離時印記收緊，造成額外傷害。",
    "tracking": "追蹤：逃亡期間每次休息都有機率被主人找到。",
    "spell_seal": "魔力封印：只能施放低環的法術。"
  },

  "freedom": {
    "$comment": "主角身為奴隸時的談判與逃離。談判 DC = 契約 negotiate_dc - floor(主人親密度 / 20)；逃離 DC = escape_dc。失敗會受罰。",
    "negotiate": { "attr": "cha", "hours": 1, "affinity_step": 20 },
    "escape": { "attr": "dex", "hours": 2 },
    "punishment": {
      "light": { "hp_ratio": 0.2, "affinity": -5 },
      "heavy": { "hp_ratio": 0.4, "affinity": -10, "obedience": 1 }
    },
    "obedience_max": 8,
    "fugitive": { "inn_mult": 2, "inn_recapture_mult": 1.5 }
  },

  "release_affinity": 15,

  "custom_mark": {
    "$comment": "自訂印記（建立角色、買奴隸時）的數值範圍；超出的會被夾回範圍內。",
    "income_share": [0, 1],
    "negotiate_dc": [8, 30],
    "escape_dc": [8, 30],
    "exit_dc": [5, 25],
    "recapture_chance": [0, 0.6],
    "escape_hp_ratio": [0, 0.8],
    "obedience_penalty": [0, 8],
    "name_chars": 12,
    "mark_chars": 160,
    "side_effect_chars": 40,
    "side_effects": 4
  },

  "master_permit": {
    "$comment": "主角身為奴隸時，出城（到近郊）或旅行前要先得到主人同意：魅力檢定，DC = 印記的 exit_dc + 目前的服從懲罰 - floor(主人親密度 / affinity_step)。可以描述請求的理由，交給 AI 判定合理性。同意後當天在這座城不用再問；被拒絕當天就不能再問。大失敗會受到輕度懲罰。",
    "attr": "cha",
    "hours": 0.25,
    "affinity_step": 20
  },

  "safe_spots": ["inn", "safe", "temple"],

  "marking": {
    "$comment": "成為奴隸時的刻印檢定（可以描述自己的行為，例如討好、反抗、哀求）：DC = base + floor(主人等級 / 2)。結果決定可以選的印記：大成功可以任選或自訂，成功可以選主人原本打算的或更輕的，部分成功就是主人原本打算的，失敗加重一級，大失敗最重而且服從懲罰 +1。印記由輕到重依 severity。",
    "attr": "cha",
    "base": 12,
    "severity": ["labor", "combat", "arcane"]
  },

  "slave_target_advantage": "主角對自己的奴隸主動行動時，奴隸抗拒的檢定處於劣勢：主角擲兩次取較高的。",

  "master_events": {
    "$comment": "主角被主人帶著時，移動與旅行可能發生的突發事件。移動時每一步 step_chance、旅行時每趟 travel_chance，而且距離上次至少 cooldown_hours 小時。事件發生後，玩家從三個 options 選一個回應，或自己輸入回應（主動行動 master_event，參考 DC 依事件的 free，沒有時用 free_dc）。option：沒有 check 時直接套用 effects；有 check 時檢定，成功套用 effects_success、失敗套用 fail_effects（effects 兩者都套用）。adult：成人向事件，設定開啟「成人向」時才會發生。effects 用報酬模板，npc 寫 master 代表主人。free_outcomes：自己輸入的回應沒有 AI 判定時，依成功程度套用的效果。",
    "step_chance": 0.02,
    "travel_chance": 0.35,
    "cooldown_hours": 6,
    "free_dc": 13,
    "free_outcomes": {
      "critical": [{ "type": "affinity", "npc": "master", "delta": 3, "reason": "應對得體" }],
      "success": [{ "type": "affinity", "npc": "master", "delta": 1, "reason": "應對得體" }],
      "partial": [],
      "fail": [{ "type": "affinity", "npc": "master", "delta": -2, "reason": "惹主人不快" }],
      "fumble": [{ "type": "affinity", "npc": "master", "delta": -4, "reason": "觸怒主人" }, { "type": "hp", "target": "pc", "amount": -3 }]
    },
    "events": [
      { "id": "errand", "weight": 4, "text": "{master}塞給你一張清單，要你去替他跑腿採買。", "hours": 1, "options": [
        { "label": "乖乖照辦", "result": "你跑遍了市集，把東西買齊交了回去。", "effects": [{ "type": "money", "amount": -15 }, { "type": "affinity", "npc": "master", "delta": 1, "reason": "跑腿辦得妥當" }] },
        { "label": "殺價省下零錢", "check": { "attr": "cha", "dc": 12 }, "success": "你殺了價，把省下的零錢交回去，{master}難得點了點頭。", "fail": "店家不肯讓價，還耽擱了不少時間。", "effects_success": [{ "type": "money", "amount": -8 }, { "type": "affinity", "npc": "master", "delta": 2, "reason": "精打細算" }], "fail_effects": [{ "type": "money", "amount": -15 }], "hours": 1.5 },
        { "label": "推說身上沒錢", "check": { "attr": "cha", "dc": 14 }, "success": "{master}嘖了一聲，自己掏了錢。", "fail": "{master}一眼看穿你的藉口，罵了你一頓，還是得自己出錢。", "effects_success": [{ "type": "affinity", "npc": "master", "delta": -1, "reason": "推託差事" }], "fail_effects": [{ "type": "money", "amount": -15 }, { "type": "affinity", "npc": "master", "delta": -3, "reason": "說謊推託" }] }
      ] },
      { "id": "show_off", "weight": 3, "text": "{master}在旁人面前炫耀你頸上的印記，要你乖乖站好。", "hours": 0.5, "options": [
        { "label": "順從地站好", "result": "你垂著手站好，任人打量。", "effects": [{ "type": "affinity", "npc": "master", "delta": 2, "reason": "表現順從" }] },
        { "label": "主動表現，替主人爭面子", "check": { "attr": "cha", "dc": 13 }, "success": "旁人嘖嘖稱奇，{master}得意極了。", "fail": "你表現得太刻意，反而讓{master}丟了臉。", "effects_success": [{ "type": "affinity", "npc": "master", "delta": 4, "reason": "替主人爭面子" }], "fail_effects": [{ "type": "affinity", "npc": "master", "delta": -2, "reason": "讓主人丟臉" }] },
        { "label": "低頭別過臉", "result": "{master}不太高興，但沒當眾說什麼。", "effects": [{ "type": "affinity", "npc": "master", "delta": -1, "reason": "不配合" }] }
      ] },
      { "id": "bad_mood", "weight": 3, "text": "{master}心情很差，把怒氣出在你身上。", "hours": 0.25, "options": [
        { "label": "低聲下氣地安撫", "check": { "attr": "cha", "dc": 13 }, "success": "你低聲下氣地應付過去。", "fail": "怎麼說都不對，{master}的怒氣反而更大。", "fail_effects": [{ "type": "hp", "target": "pc", "amount": -3 }, { "type": "affinity", "npc": "master", "delta": -2, "reason": "惹主人不快" }] },
        { "label": "默默承受", "result": "你咬著牙挨過這一陣。", "effects": [{ "type": "hp", "target": "pc", "amount": -3 }] },
        { "label": "頂嘴", "check": { "attr": "cha", "dc": 16 }, "success": "{master}愣了一下，反而收斂了脾氣。", "fail": "{master}勃然大怒，下手更重。", "effects_success": [{ "type": "affinity", "npc": "master", "delta": 1, "reason": "敢於直言" }], "fail_effects": [{ "type": "hp", "target": "pc", "amount": -5 }, { "type": "affinity", "npc": "master", "delta": -4, "reason": "頂嘴" }] }
      ] },
      { "id": "reward", "weight": 2, "text": "{master}難得心情好，賞了你一點零錢。", "hours": 0.1, "options": [
        { "label": "道謝收下", "result": "你道了謝，把零錢收好。", "effects": [{ "type": "money", "amount": 20 }, { "type": "affinity", "npc": "master", "delta": 2, "reason": "被賞賜" }] },
        { "label": "趁機討多一點", "check": { "attr": "cha", "dc": 13 }, "success": "{master}笑罵你貪心，又多給了一些。", "fail": "{master}的好心情一下子沒了，把錢收了回去。", "effects_success": [{ "type": "money", "amount": 40 }, { "type": "affinity", "npc": "master", "delta": 1, "reason": "討賞" }], "fail_effects": [{ "type": "affinity", "npc": "master", "delta": -2, "reason": "貪心" }] },
        { "label": "把錢還給主人表示忠心", "check": { "attr": "fai", "dc": 12 }, "success": "{master}有些意外，看你的眼神柔和了一點。", "fail": "{master}覺得你在裝模作樣。", "effects_success": [{ "type": "affinity", "npc": "master", "delta": 4, "reason": "表示忠心" }] }
      ] },
      { "id": "carry", "weight": 3, "text": "{master}把沉重的行李都丟給你扛。", "hours": 0.5, "options": [
        { "label": "咬牙硬扛", "check": { "attr": "str", "dc": 12 }, "success": "你咬著牙扛了下來。", "fail": "你扛得肩膀都磨破了。", "fail_effects": [{ "type": "hp", "target": "pc", "amount": -2 }] },
        { "label": "分幾趟慢慢搬", "result": "你分了好幾趟才搬完，{master}嫌你慢。", "effects": [{ "type": "affinity", "npc": "master", "delta": -1, "reason": "動作太慢" }], "hours": 1.5 },
        { "label": "請主人雇個挑夫", "check": { "attr": "cha", "dc": 14 }, "success": "{master}勉強同意，雇了個挑夫。", "fail": "{master}罵你偷懶，行李還是得你扛。", "fail_effects": [{ "type": "hp", "target": "pc", "amount": -2 }, { "type": "affinity", "npc": "master", "delta": -2, "reason": "想偷懶" }] }
      ] },
      { "id": "test_loyalty", "weight": 2, "text": "{master}故意把錢袋放在你面前，看你會不會動心。", "hours": 0.25, "options": [
        { "label": "視而不見", "check": { "attr": "fai", "dc": 12 }, "success": "你連看都沒看，{master}滿意地點點頭。", "fail": "你忍不住多看了錢袋一眼。", "effects_success": [{ "type": "affinity", "npc": "master", "delta": 3, "reason": "通過考驗" }], "fail_effects": [{ "type": "affinity", "npc": "master", "delta": -3, "reason": "多看了錢袋一眼" }] },
        { "label": "把錢袋交還主人", "result": "你把錢袋原封不動地交還，{master}收下了。", "effects": [{ "type": "affinity", "npc": "master", "delta": 2, "reason": "交還錢袋" }] },
        { "label": "偷拿幾枚", "check": { "attr": "dex", "dc": 15 }, "success": "你手指一勾，幾枚硬幣就滑進了袖子。", "fail": "你的手才伸出去就被當場抓住。", "effects_success": [{ "type": "money", "amount": 30 }], "fail_effects": [{ "type": "affinity", "npc": "master", "delta": -6, "reason": "偷錢被抓" }, { "type": "hp", "target": "pc", "amount": -3 }] }
      ] },
      { "id": "proposition", "weight": 2, "adult": true, "text": "{master}把你叫到身邊，直白地提出要你今晚陪伴。", "hours": 0.25, "options": [
        { "label": "答應", "result": "你點了頭，{master}的神情柔和下來。", "effects": [{ "type": "affinity", "npc": "master", "delta": 4, "reason": "答應了主人的邀約" }], "hours": 2 },
        { "label": "委婉推辭", "check": { "attr": "cha", "dc": 14 }, "success": "{master}沒有勉強，只是揮手讓你退下。", "fail": "{master}的臉色沉了下來，沒再多說。", "fail_effects": [{ "type": "affinity", "npc": "master", "delta": -3, "reason": "推辭了主人的邀約" }] },
        { "label": "斷然拒絕", "check": { "attr": "fai", "dc": 15 }, "success": "{master}愣了一下，竟對你有些另眼相看。", "fail": "{master}被拂了面子，冷冷地讓你滾開。", "effects_success": [{ "type": "affinity", "npc": "master", "delta": 1, "reason": "堅守底線" }], "fail_effects": [{ "type": "affinity", "npc": "master", "delta": -5, "reason": "當面拒絕主人" }] }
      ] }
    ]
  }
