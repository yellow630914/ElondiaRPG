{
  "$comment": "奴隸市場、奴隸契約與契約印記。價格依世界書「奴隸交易價格參考」（金額單位為白鸛幣；世界書的 1 金幣 = 100、1 白金幣 = 1000 白鸛幣）。人類國家合法且興盛；魔族聯盟多以物易物；精靈王庭禁止奴隸交易，精靈只在黑市出現、風險極高。說明見 docs/COMPANIONS.md。",
  "version": 1,

  "prices_cc": {
    "$comment": "依生命層級與種族群組的價格區間。層級內依等級線性內插，再乘上職業與種族倍率、市場倍率與 ±variance 的浮動。第 4 層以上每層 × beyond_tier3_mult。",
    "1": { "human": [800, 8000], "demon": [1000, 9000], "elf": [8000, 40000] },
    "2": { "human": [20000, 25000], "demon": [22000, 28000], "elf": [250000, 280000] },
    "3": { "human": [400000, 450000], "demon": [450000, 500000], "elf": [2000000, 2500000] },
    "beyond_tier3_mult": 5,
    "variance": 0.25,
    "race_group": { "human": "human", "catfolk": "human", "dwarf": "human", "demon": "demon", "elf": "elf", "yulin": "elf" },
    "race_mult": { "catfolk": 0.9, "dwarf": 1.2 },
    "class_mult": { "wizard": 1.3, "cleric": 1.25, "druid": 1.2, "bard": 1.1, "paladin": 1.15 }
  },

  "black_market_only": ["elf", "yulin"],

  "markets": {
    "rhineburg": { "public": { "name": "帝國奴隸市場", "price_mult": 1.0, "stock": [3, 5], "races": { "human": 6, "catfolk": 2, "dwarf": 1, "demon": 1 } } },
    "dawnlight": { "public": { "name": "晨光城奴隸拍賣場", "price_mult": 1.05, "stock": [3, 4], "races": { "human": 6, "catfolk": 2, "demon": 1 } } },
    "albena": {
      "public": { "name": "自由集市・奴隸區", "price_mult": 0.95, "stock": [3, 5], "races": { "human": 5, "catfolk": 2, "dwarf": 1, "demon": 2 } },
      "black": { "name": "自由集市地下拍賣", "price_mult": 0.8, "stock": [2, 4], "races": { "human": 3, "demon": 2, "elf": 2, "yulin": 1 } }
    },
    "soriel": { "black": { "name": "外環的地下奴隸販子", "price_mult": 0.85, "stock": [2, 3], "races": { "human": 4, "catfolk": 2, "elf": 1 } } },
    "bloodplume": { "public": { "name": "血羽城堡交易廣場（以物易物）", "price_mult": 1.1, "stock": [3, 5], "races": { "demon": 4, "human": 4, "catfolk": 1 } } },
    "shadow_vale": { "public": { "name": "陰影之谷奴隸市", "price_mult": 1.0, "stock": [2, 4], "races": { "demon": 4, "human": 3 } } },
    "ashport": { "black": { "name": "灰港鎮碼頭黑市", "price_mult": 0.75, "stock": [3, 5], "races": { "human": 3, "demon": 3, "catfolk": 1, "elf": 1 } } },
    "tidehaven": { "black": { "name": "潮汐港走私船艙", "price_mult": 0.9, "stock": [2, 3], "races": { "human": 2, "yulin": 1, "elf": 1 } } }
  },

  "black_market_search": { "attr": "cha", "dc": 14, "hours": 2 },

  "haggle": {
    "$comment": "殺價、魅惑等主動行動。成功程度決定價格倍率；失敗後當天不能再殺價。DC = base + 2 × 市場是黑市。",
    "attr": "cha",
    "base": 12,
    "black_market_bonus": 2,
    "price_factor": { "critical": 0.7, "success": 0.85, "partial": 0.95, "fail": 1.0, "fumble": 1.1 }
  },

  "self_sale": {
    "$comment": "主角在市場登記出售自己。買家出現機率 = base + per_cha_mod × mod(魅力) + per_level × 等級；主角拿到成交價的 share（賣身錢）。幾乎無法主動影響。",
    "hours": 6,
    "base": 0.3,
    "per_cha_mod": 0.07,
    "per_level": 0.03,
    "max": 0.85,
    "share": 0.2,
    "contract_weights": { "labor": 6, "combat": 3, "arcane": 1 }
  },

  "contracts": {
    "labor": {
      "name": "勞役契約",
      "mark": "頸側一圈暗紅色的荊棘紋，主人的名字以細小的古文字刻在紋路之間。",
      "functions": ["identity", "obedience", "income", "tracking"],
      "obedience_penalty": 2,
      "income_share": 0.5,
      "negotiate_dc": 18,
      "escape_dc": 17,
      "recapture_chance": 0.1,
      "exit_dc": 12,
      "side_effects": ["違抗主人的命令時印記會刺痛", "見到主人時頸部微微發熱"],
      "escape_effects": { "hp_ratio": 0.1 }
    },
    "combat": {
      "name": "戰奴契約",
      "mark": "頸後一枚交叉雙劍的黑色烙印，延伸出鎖鏈狀的紋路繞過喉頭。",
      "functions": ["identity", "obedience", "income", "tether", "tracking"],
      "obedience_penalty": 3,
      "income_share": 1.0,
      "negotiate_dc": 20,
      "escape_dc": 19,
      "recapture_chance": 0.2,
      "exit_dc": 14,
      "side_effects": ["無法對主人揮出武器", "離主人太遠時鎖鏈紋會收緊，呼吸困難"],
      "escape_effects": { "hp_ratio": 0.3 }
    },
    "arcane": {
      "name": "魔導束縛契約",
      "mark": "喉頭正中一枚淡紫色的法陣，會隨主人的魔力脈動。",
      "functions": ["identity", "obedience", "income", "tracking", "spell_seal"],
      "obedience_penalty": 5,
      "income_share": 1.0,
      "spell_cap": 1,
      "negotiate_dc": 22,
      "escape_dc": 22,
      "recapture_chance": 0.35,
      "exit_dc": 16,
      "side_effects": ["法陣抽取魔力，最多只能施放 1 環法術", "主人能感知印記的位置"],
      "escape_effects": { "hp_ratio": 0.4 }
    }
  },

  "functions": {
    "identity": "身分標示：任何人一眼就能認出是奴隸與其主人。",
    "obedience": "服從：對主人的檢定受到懲罰。",
    "income": "收益歸屬：奴隸得到的金錢有一部分（或全部）歸主人。",
    "tether": "距離束縛：逃離時印記收緊，造成額外傷害。",
    "tracking": "追蹤：逃亡期間每次休息都有機率被主人找到。",
    "spell_seal": "魔力封印：只能施放低環的法術。"
  },

  "freedom": {
    "$comment": "主角身為奴隸時的談判與逃離。談判 DC = 契約 negotiate_dc - floor(主人親密度 / 20)；逃離 DC = escape_dc。失敗會受罰。",
    "negotiate": { "attr": "cha", "hours": 1, "affinity_step": 20 },
    "escape": { "attr": "dex", "hours": 2 },
    "punishment": {
      "light": { "hp_ratio": 0.2, "affinity": -5 },
      "heavy": { "hp_ratio": 0.4, "affinity": -10, "obedience": 1 }
    },
    "obedience_max": 8,
    "fugitive": { "inn_mult": 2, "inn_recapture_mult": 1.5 }
  },

  "release_affinity": 15,

  "custom_mark": {
    "$comment": "自訂印記（建立角色、買奴隸時）的數值範圍；超出的會被夾回範圍內。",
    "income_share": [0, 1],
    "negotiate_dc": [8, 30],
    "escape_dc": [8, 30],
    "exit_dc": [5, 25],
    "recapture_chance": [0, 0.6],
    "escape_hp_ratio": [0, 0.8],
    "obedience_penalty": [0, 8],
    "name_chars": 12,
    "mark_chars": 160,
    "side_effect_chars": 40,
    "side_effects": 4
  },

  "master_permit": {
    "$comment": "主角身為奴隸時，出城（到近郊）或旅行前要先得到主人同意：魅力檢定，DC = 印記的 exit_dc + 目前的服從懲罰 - floor(主人親密度 / affinity_step)。可以描述請求的理由，交給 AI 判定合理性。同意後當天在這座城不用再問；被拒絕當天就不能再問。大失敗會受到輕度懲罰。",
    "attr": "cha",
    "hours": 0.25,
    "affinity_step": 20
  },

  "safe_spots": ["inn", "safe", "temple"],

  "marking": {
    "$comment": "成為奴隸時的刻印檢定（可以描述自己的行為，例如討好、反抗、哀求）：DC = base + floor(主人等級 / 2)。結果決定可以選的印記：大成功可以任選或自訂，成功可以選主人原本打算的或更輕的，部分成功就是主人原本打算的，失敗加重一級，大失敗最重而且服從懲罰 +1。印記由輕到重依 severity。",
    "attr": "cha",
    "base": 12,
    "severity": ["labor", "combat", "arcane"]
  },

  "slave_target_advantage": "主角對自己的奴隸主動行動時，奴隸抗拒的檢定處於劣勢：主角擲兩次取較高的。",

  "master_events": {
    "$comment": "主角被主人帶著時，移動與旅行可能發生的突發事件。移動時每一步 step_chance、旅行時每趟 travel_chance，而且距離上次至少 cooldown_hours 小時。effects 用報酬模板（npc 寫 master 代表主人）；有 check 時先檢定，失敗才套用 fail_effects。",
    "step_chance": 0.02,
    "travel_chance": 0.35,
    "cooldown_hours": 6,
    "events": [
      { "id": "errand", "weight": 4, "text": "{master}塞給你一張清單，要你去替他跑腿採買。", "effects": [{ "type": "money", "amount": -15 }], "hours": 1 },
      { "id": "show_off", "weight": 3, "text": "{master}在旁人面前炫耀你頸上的印記，要你乖乖站好。", "effects": [{ "type": "affinity", "npc": "master", "delta": 2, "reason": "表現順從" }], "hours": 0.5 },
      { "id": "bad_mood", "weight": 3, "text": "{master}心情很差，把怒氣出在你身上。", "check": { "attr": "cha", "dc": 13, "success": "你低聲下氣地應付過去。" }, "fail_effects": [{ "type": "hp", "target": "pc", "amount": -3 }, { "type": "affinity", "npc": "master", "delta": -2, "reason": "惹主人不快" }], "hours": 0.25 },
      { "id": "reward", "weight": 2, "text": "{master}難得心情好，賞了你一點零錢。", "effects": [{ "type": "money", "amount": 20 }, { "type": "affinity", "npc": "master", "delta": 2, "reason": "被賞賜" }], "hours": 0.1 },
      { "id": "carry", "weight": 3, "text": "{master}把沉重的行李都丟給你扛。", "check": { "attr": "str", "dc": 12, "success": "你咬著牙扛了下來。" }, "fail_effects": [{ "type": "hp", "target": "pc", "amount": -2 }], "hours": 0.5 },
      { "id": "test_loyalty", "weight": 2, "text": "{master}故意把錢袋放在你面前，看你會不會動心。", "check": { "attr": "fai", "dc": 12, "success": "你連看都沒看，{master}滿意地點點頭。" }, "effects_success": [{ "type": "affinity", "npc": "master", "delta": 3, "reason": "通過考驗" }], "fail_effects": [{ "type": "affinity", "npc": "master", "delta": -3, "reason": "多看了錢袋一眼" }], "hours": 0.25 }
    ]
  }
}
