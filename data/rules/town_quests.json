      "hours": 3, "encounter": [["giant_rat", 3]], "reward_cc": [35, 50]
    },
    {
      "id": "goblin_scouts", "kind": "hunt", "area": "outskirts",
      "title": "討伐在{town}近郊出沒的哥布林", "scene": "{town}近郊的丘陵",
      "hours": 4, "encounter": [["goblin", 2]], "reward_cc": [40, 50]
    },
    {
      "id": "scout_road", "kind": "search", "area": "outskirts",
      "title": "偵查{town}近郊商道的異狀", "scene": "{town}近郊的商道",
      "hours": 3, "dc": 12, "encounter_chance": 0.2, "encounter": [["wolf", 2]], "reward_cc": [35, 50]
    }
  ]
