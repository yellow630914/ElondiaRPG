        { "id": "middle", "name": "中層", "encounters": [3, 5], "traps": [1, 3], "resources": [1, 2], "elites": 1, "trap_dc": 13, "trap_damage": "2d6" },
        { "id": "deep", "name": "深層", "encounters": [3, 5], "traps": [2, 3], "resources": [1, 3], "elites": 1, "boss": true, "trap_dc": 15, "trap_damage": "3d6" }
