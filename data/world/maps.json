          "grid": [
            "#########",
            "#G..C..S#",
            "#.##.##.#",
            "#.......#",
            "#.##.##.#",
            "#.......#",
            "####1####"
          ],
          "links": { "1": "gate" }
        }
      ]
    },
    "city": {
      "blocks": [
        {
          "id": "main", "name": "{town}",
