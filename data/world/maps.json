{
  "$comment": "城市與城鎮的固定格子地圖。一個地點由一或多個區塊組成，每個區塊是一張 ASCII 格子圖（每列字數相同）。圖例見 legend；數字 1-9 是區塊之間的通道，links 指定通往哪個區塊的同一個數字格。城門 E 可以出城到近郊或啟程旅行。maps 為個別地點的專屬地圖；沒有專屬地圖的聚落依類型使用 templates，區塊名稱中的 {town} 會換成地點名稱。地下城與近郊荒野的格子是隨機生成的，參數在 generation。",
  "version": 1,
  "legend": {
    "#": { "kind": "wall", "name": "建築" },
    "~": { "kind": "water", "name": "水道" },
    ".": { "kind": "floor", "name": "街道" },
    "I": { "kind": "inn", "name": "旅店" },
    "G": { "kind": "guild", "name": "冒險者公會" },
    "T": { "kind": "tavern", "name": "酒館" },
    "S": { "kind": "shop", "name": "雜貨店" },
    "C": { "kind": "temple", "name": "神殿" },
    "E": { "kind": "gate", "name": "城門" }
  },
  "maps": {
