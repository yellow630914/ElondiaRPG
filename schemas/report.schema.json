{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elondia/report.schema.json",
  "title": "ElondiaRPG 事件報告",
  "description": "遊戲引擎在一次行動、事件或戰鬥結束後輸出的結構化報告。引擎是數值的唯一來源；AI 只把報告寫成敘事，不得改動任何數值或結果。",
  "type": "object",
  "required": ["schema_version", "report_id", "kind", "time", "location", "party", "outcome", "changes"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "report_id": { "type": "string" },
    "kind": { "enum": ["travel", "combat", "action", "event", "quest", "rest", "trade", "social"] },
    "time": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/game_time" },
        "end": { "$ref": "#/$defs/game_time" }
      }
    },
    "location": {
      "type": "object",
      "required": ["at"],
      "properties": {
        "at": { "type": "string", "description": "geography.json 的 location id；旅行中為出發地" },
        "to": { "type": "string" },
        "region": { "type": "string" },
        "scene": { "type": "string", "description": "更細的場景描述，例如「蛇溪洞窟第二層」" },
        "weather": { "type": "string" }
      }
    },
    "party": {
      "type": "array",
      "description": "玩家方角色在事件前後的狀態快照",
      "items": { "$ref": "#/$defs/actor_state" }
    },
    "others": {
      "type": "array",
      "description": "敵人、NPC 等非玩家方角色",
      "items": { "$ref": "#/$defs/actor_state" }
    },
    "quest": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "rank": { "enum": ["F", "E", "D", "C", "B", "A", "S"] },
        "status": { "enum": ["accepted", "progress", "completed", "failed", "abandoned"] }
      }
    },
    "story": {
      "type": "object",
      "description": "特殊任務（人工編寫的任務鏈）：哪個任務、哪個任務點",
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "node": { "type": "string" },
        "status": { "enum": ["started", "progress", "completed", "failed"] }
      }
    },
    "timeline": {
      "type": "array",
      "description": "依時間排序的關鍵節拍。戰鬥時每回合或每個重要動作一筆；旅行時每天或每個遭遇一筆。",
      "items": {
        "type": "object",
        "required": ["seq", "actor", "action", "result"],
        "properties": {
          "seq": { "type": "integer" },
          "round": { "type": "integer" },
          "time": { "$ref": "#/$defs/game_time" },
          "actor": { "type": "string" },
          "action": { "type": "string", "description": "動作或技能名稱" },
          "target": { "type": "string" },
          "roll": {
            "type": "object",
            "properties": {
              "dice": { "type": "string", "examples": ["1d20+5"] },
              "value": { "type": "integer" },
              "dc": { "type": "integer" },
              "save": { "type": "boolean", "description": "豁免：value 是目標的豁免，dc 是施放者的豁免難度" }
            }
          },
          "result": { "enum": ["success", "critical", "fail", "fumble", "partial", "none"] },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "enum": ["damage", "heal", "status_add", "status_remove", "move", "item", "flag", "note"] },
                "target": { "type": "string" },
                "amount": { "type": "number" },
                "element": { "type": "string" },
                "status": { "type": "string" },
                "text": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["result"],
      "properties": {
        "result": { "enum": ["victory", "defeat", "fled", "arrived", "interrupted", "success", "failure", "neutral"] },
        "summary": { "type": "string", "description": "引擎產生的一句話結果，供 AI 對照" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "changes": {
      "type": "object",
      "description": "這次報告造成的所有狀態變化。AI 必須在敘事中如實反映，不能增減。",
      "properties": {
        "money_cc": { "type": "integer" },
        "xp": { "type": "array", "items": { "$ref": "#/$defs/actor_delta" } },
        "level_up": { "type": "array", "items": { "$ref": "#/$defs/actor_delta" } },
        "skills_gained": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["actor", "skill", "quality", "source"],
            "properties": {
              "actor": { "type": "string" },
              "skill": { "type": "string" },
              "quality": { "enum": ["common", "uncommon", "rare", "epic", "legendary", "mythic"] },
              "source": { "enum": ["level_up", "study", "insight", "bloodline", "race_change"] }
            }
          }
        },
        "items_gained": { "type": "array", "items": { "$ref": "#/$defs/item_delta" } },
        "items_lost": { "type": "array", "items": { "$ref": "#/$defs/item_delta" } },
        "affinity": {
          "type": "array",
          "description": "親密值變化。屬隱性規則，敘事中只能透過態度呈現，不可寫出數字。",
          "items": {
            "type": "object",
            "required": ["npc", "delta", "after"],
            "properties": {
              "npc": { "type": "string" },
              "delta": { "type": "integer" },
              "after": { "type": "integer" },
              "reason": { "type": "string" }
            }
          }
        },
        "reputation": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "faction": { "type": "string" }, "delta": { "type": "integer" } }
          }
        },
        "flags": { "type": "object", "additionalProperties": true },
        "merit": { "type": "integer", "description": "主角得到的冒險者公會功績點" },
        "craft_xp": {
          "type": "array",
          "description": "工藝經驗：誰的哪種工藝得到多少；level 是升到的等級",
          "items": {
            "type": "object",
            "required": ["actor", "craft", "amount"],
            "properties": {
              "actor": { "type": "string" },
              "craft": { "enum": ["smithing", "woodworking", "leatherwork", "tailoring", "jewelcraft", "alchemy", "cooking"] },
              "amount": { "type": "integer" },
              "level": { "type": "integer" }
            }
          }
        },
        "rank_up": {
          "type": "object",
          "description": "通過晉升考核，主角的公會階級提升",
          "required": ["from", "to"],
          "properties": { "from": { "enum": ["F", "E", "D", "C", "B", "A", "S"] }, "to": { "enum": ["F", "E", "D", "C", "B", "A", "S"] } }
        },
        "companions": {
          "type": "array",
          "description": "夥伴的進出：入隊、離隊、獲釋、成為奴隸、逃亡、被抓回。npc 為 pc 時是主角本人。",
          "items": {
            "type": "object",
            "required": ["npc", "name", "change"],
            "properties": {
              "npc": { "type": "string" },
              "name": { "type": "string" },
              "change": { "enum": ["joined", "left", "freed", "enslaved", "escaped", "recaptured", "transferred"] },
              "bond": { "enum": ["hired", "voluntary", "slave", "leader", "ally", "guest"] },
              "reason": { "type": "string" }
            }
          }
        },
        "conditions": {
          "type": "array",
          "description": "非戰鬥狀態（奴隸契約印記、逃亡奴隸、受罰）的增減。",
          "items": {
            "type": "object",
            "required": ["actor", "condition", "added"],
            "properties": { "actor": { "type": "string" }, "condition": { "type": "string" }, "added": { "type": "boolean" } }
          }
        },
        "lewd": {
          "type": "array",
          "description": "慾望指標的增減（淫亂、敏感、忍耐、順從；曝露名聲記地區）。",
          "items": { "type": "object", "required": ["actor", "stat", "delta", "after"], "properties": { "actor": { "type": "string" }, "stat": { "type": "string" }, "delta": { "type": "integer" }, "after": { "type": "integer" }, "region": { "type": "string" } } }
        },
        "perks": {
          "type": "array",
          "description": "特質的增減（學會或失去）。",
          "items": { "type": "object", "required": ["actor", "perk", "name", "added"], "properties": { "actor": { "type": "string" }, "perk": { "type": "string" }, "name": { "type": "string" }, "added": { "type": "boolean" } } }
        },
        "tattoos": {
          "type": "array",
          "description": "刺上或洗掉的刺青（普通刺青、誓約印記；奴隸印記記在 companions 的 enslaved / freed）。",
          "items": {
            "type": "object", "required": ["actor", "place", "kind", "name", "added"],
            "properties": { "actor": { "type": "string" }, "place": { "type": "string" }, "kind": { "enum": ["slave", "oath", "plain"] }, "name": { "type": "string" }, "added": { "type": "boolean" } }
          }
        },
        "hit_dice": {
          "type": "array",
          "description": "短休花費、長休回復的生命骰。",
          "items": {
            "type": "object",
            "required": ["actor"],
            "properties": {
              "actor": { "type": "string" },
              "spent": { "type": "integer" },
              "regained": { "type": "integer" },
              "healed": { "type": "integer" }
            }
          }
        },
        "master_share_cc": { "type": "integer", "description": "奴隸契約的收益歸屬：被主人拿走的金錢（已從 money_cc 扣除）。" },
        "resources": {
          "type": "array",
          "description": "法術環、生命骰、每次休息可用次數的增減（例如為了談判施放魅惑術而花掉的法術環）。",
          "items": {
            "type": "object",
            "required": ["actor", "kind", "delta"],
            "properties": {
              "actor": { "type": "string" },
              "kind": { "enum": ["slot", "hit_dice", "ability_use"] },
              "delta": { "type": "integer" },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "check": {
      "type": "object",
      "description": "主動行動的檢定。擲骰先發生；AI 判定（source = ai）時，AI 看著骰值決定成功與否，可以出乎預料，DC 只能在參考 DC ±3 內標示；規則判定（source = rules）依骰值對參考 DC。",
      "required": ["action", "attr", "base_dc", "dc", "natural", "modifier", "total", "degree", "source"],
      "properties": {
        "action": { "type": "string" },
        "attr": { "enum": ["str", "dex", "int", "fai", "cha"] },
        "base_dc": { "type": "integer" },
        "dc": { "type": "integer" },
        "natural": { "type": "integer", "minimum": 1, "maximum": 20 },
        "modifier": { "type": "integer", "description": "屬性調整加上情境修正" },
        "situational": {
          "type": "array", "description": "情境修正（已經算在 modifier 裡），例如某位角色的好感",
          "items": { "type": "object", "required": ["label", "value"], "properties": { "label": { "type": "string" }, "value": { "type": "integer" } } }
        },
        "total": { "type": "integer" },
        "degree": { "enum": ["critical", "success", "partial", "fail", "fumble"] },
        "trivial": { "type": "boolean", "description": "AI 判為日常小事（自由行動）：結果至少是成功，骰值只決定過程順不順" },
        "reference_degree": { "enum": ["critical", "success", "partial", "fail", "fumble"], "description": "骰值對 DC 算出的參考成功程度；只在與實際結果不同時記錄" },
        "source": { "enum": ["ai", "rules"] },
        "rationale": { "type": "string" },
        "twist": { "type": "string", "description": "AI 讓結果出乎預料時的說明" }
      }
    },
    "narration": {
      "type": "object",
      "description": "給 AI 的敘事指示",
      "properties": {
        "pov": { "enum": ["second_person", "third_person"], "default": "second_person" },
        "length": { "enum": ["short", "medium", "long"], "default": "medium" },
        "tone": { "type": "string" },
        "focus": { "type": "array", "items": { "type": "string" } },
        "player_intent": { "type": "string", "description": "玩家在 UI 上選擇的意圖或自由輸入的備註" },
        "mode": { "enum": ["defeat_cliffhanger", "defeat_event"], "description": "特殊的敘事：戰敗事件的前半段（停在對方動手前）與後半段（玩家回應之後）" },
        "adult_scene": { "type": "string", "description": "成人向的親密場景（只在開啟成人向時）：這段經過是什麼；敘事會附上成人場景規則，在正文詳細描寫" },
        "adult_actor": { "type": "string", "description": "親密場景的主角不是主角本人時（派奴隸去娼館接客）：那個人的 id" }
      }
    },
    "lore_keys": {
      "type": "array",
      "description": "用來從世界書挑選條目的關鍵字（地名、勢力、種族）。引擎自動填入，也可手動補充。",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "game_time": {
      "type": "object",
      "required": ["day"],
      "description": "day 為自開局起算的第幾天；hour 0-23",
      "properties": {
        "day": { "type": "integer", "minimum": 1 },
        "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
        "minute": { "type": "integer", "minimum": 0, "maximum": 59 }
      }
    },
    "actor_state": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "race": { "type": "string" },
        "class": { "type": "string" },
        "level": { "type": "integer" },
        "rank": { "type": "string" },
        "hp": { "type": "array", "prefixItems": [{ "type": "integer" }, { "type": "integer" }, { "type": "integer" }], "description": "[事件前, 事件後, 上限]" },
        "mp": { "type": "array", "prefixItems": [{ "type": "integer" }, { "type": "integer" }, { "type": "integer" }] },
        "status": { "type": "array", "items": { "type": "string" } },
        "equipment": { "type": "array", "items": { "type": "string" } },
        "gender": { "type": "string", "description": "性別（顯示名稱）" },
        "personality": { "type": "string", "description": "NPC 性格摘要，供 AI 演繹（角色扮演指導第三層）" },
        "attitude": { "type": "string", "description": "引擎依實力差、立場、親密值算出的態度，AI 據此演繹" }
      }
    },
    "actor_delta": {
      "type": "object",
      "required": ["actor"],
      "properties": {
        "actor": { "type": "string" },
        "amount": { "type": "integer" },
        "from": { "type": "integer" },
        "to": { "type": "integer" }
      }
    },
    "item_delta": {
      "type": "object",
      "required": ["name", "qty"],
      "properties": {
        "name": { "type": "string" },
        "qty": { "type": "integer" },
        "quality": { "type": "string" },
        "owner": { "type": "string" }
      }
    }
  }
}
